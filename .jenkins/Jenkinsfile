pipeline {
    agent any

    environment {
        ECR_REPOSITORY = credentials('ECR_REPOSITORY')
        AWS_ACCOUNT_ID = credentials('AWS_ACCOUNT_ID')
        AWS_ACCESS_KEY_ID = credentials('AWS_ACCESS_KEY_ID')
        AWS_SECRET_ACCESS_KEY = credentials('AWS_SECRET_ACCESS_KEY')

        AWS_REGION = 'us-east-1'
        ECR_REGISTRY = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"
        IMAGE_NAME = "${ECR_REPOSITORY}:latest"
    }

    stages {

        stage('Continuous Integration') {
            steps {
                script {
                    echo 'Running Continuous Integration'

                    sh '''
                        test -f Dockerfile
                        test -f requirements.txt

                        echo "Docker version:"
                        docker --version

                        echo "AWS CLI version:"
                        aws --version
                    '''
                }
            }
        }

        stage('Login to ECR') {
            steps {
                script {
                    echo 'Logging in to Amazon ECR'

                    sh '''
                        aws ecr get-login-password --region ${AWS_REGION} | \
                        docker login \
                        --username AWS \
                        --password-stdin ${ECR_REGISTRY}
                    '''
                }
            }
        }

        stage('Build Image') {
            steps {
                script {
                    echo "Building Docker image"

                    sh '''
                        docker build \
                        -t ${ECR_REGISTRY}/${IMAGE_NAME} \
                        .
                    '''
                }
            }
        }

        stage('Push Image') {
            steps {
                script {
                    echo "Pushing Docker image to ECR"

                    sh '''
                        docker push ${ECR_REGISTRY}/${IMAGE_NAME}
                    '''
                }
            }
        }

        stage('Continuous Deployment') {
            steps {
                script {
                    echo 'Deploying application to EC2'

                    sshagent(['ssh_key']) {
                        sh '''
                            ssh -o StrictHostKeyChecking=no ubuntu@52.45.126.20 "
                                set -e

                                cd /home/ubuntu

                                echo 'Downloading docker-compose file'

                                wget -O docker-compose.yaml \
                                https://raw.githubusercontent.com/Riman6/youtube-sentiment-insight/main/Docker-compose.yaml

                                export IMAGE_NAME=${ECR_REGISTRY}/${IMAGE_NAME}

                                echo 'Logging in to ECR'

                                aws ecr get-login-password --region ${AWS_REGION} | \
                                docker login \
                                --username AWS \
                                --password-stdin ${ECR_REGISTRY}

                                echo 'Stopping old container'
                                echo 'Downloading Prometheus config'

                                wget -O prometheus.yml \
                                https://raw.githubusercontent.com/Riman6/youtube-sentiment-insight/main/prometheus.yml

                                docker compose down || true

                                echo 'Pulling new image'

                                docker compose pull

                                echo 'Starting new container'

                                docker compose up -d

                                echo 'Deployment completed'
                            "
                        '''
                    }
                }
            }
        }
    }

    post {
        always {
            echo 'Cleaning Docker resources'

            sh '''
                docker system prune -f || true
            '''
        }

        success {
            echo 'Pipeline completed successfully!'
        }

        failure {
            echo 'Pipeline failed. Check the console output.'
        }
    }
}